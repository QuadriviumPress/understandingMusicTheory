{
  "name": "understanding-music-theory",
  "version": "1.0.0",
  "private": true,
  "description": "A PWA-ready MyST edition of Catherine Schmidt-Jones's open music theory books.",
  "license": "MIT",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22",
    "npm": ">=10 <11"
  },
  "scripts": {
    "start": "myst start",
    "build": "myst build --html && node scripts/setup-pwa.mjs",
    "verify": "node scripts/verify-book.mjs",
    "check": "npm run verify && myst build --html --strict --check-links",
    "test": "npm run check",
    "import:cnx": "python3 scripts/import-cnx.py",
    "notation:audit": "node scripts/audit-notation.mjs --write",
    "notation:check": "node scripts/check-notation.mjs",
    "notation:render": "node scripts/render-notation.mjs"
  },
  "devDependencies": {
    "mystmd": "1.11.0",
    "sharp": "0.35.5",
    "yaml": "2.9.1",
    "jsdom": "30.1.1",
    "vexflow": "5.0.0"
  }
}
